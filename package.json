{
  "name": "amos-companion",
  "version": "1.0.0",
  "description": "AMOS Companion App — Connect Android devices to AMOS SaaS with one click",
  "private": true,
  "type": "module",
  "bin": {
    "amos-connect": "./dist-cli/cli.js"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:gui",
    "build:cli": "mkdir -p dist-cli && esbuild src/cli.ts --bundle --platform=node --outfile=dist-cli/cli.js --format=esm --target=node18 --minify",
    "build:gui": "vite build --config vite.gui.config.ts",
    "dev": "npm run build:cli && vite dev --config vite.gui.config.ts",
    "dev:tauri": "npm run build:cli && tauri dev",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "inquirer": "^9.2.0",
    "update-notifier": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/cli-progress": "^3.11.0",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18"
  }
}
