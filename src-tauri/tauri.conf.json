{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMOS Companion",
  "version": "1.6.68",
  "identifier": "online.amos.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AMOS Companion",
        "width": 900,
        "height": 650,
        "resizable": true,
        "center": true,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "dmg",
      "app",
      "appimage",
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libc6"
        ],
        "section": "net",
        "priority": "optional",
        "postInstallScript": "../scripts/deb-postinst.sh"
      }
    },
    "resources": [
      "./scrcpy-server/scrcpy-server.jar",
      "../scripts/*",
      "./debian/copyright",
      "./debian/changelog"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMkQ3MTkyNjc0QzYxQzQKUldURVlVeG5rbkV0NE5DcGVGQnVsSHpUTkdKZVEyZlBzci9uaytSanBuUmVvN3JQNC9UZEsyWGEK",
      "endpoints": [
        "https://pub-a612420d2b9c409b9017805eabd46301.r2.dev/companion/latest/update-manifest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
