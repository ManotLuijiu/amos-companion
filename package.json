{
  "name": "amos-companion",
  "version": "1.6.37",
  "description": "AMOS Companion App — Connect Android devices to AMOS SaaS with one click",
  "private": true,
  "type": "module",
  "bin": {
    "amos-connect": "./dist-cli/cli.js"
  },
  "scripts": {
    "check:version": "bun run scripts/check-version-sync.ts",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "build": "bun run build:cli && bun run build:gui",
    "build:cli": "mkdir -p dist-cli && esbuild src/cli.ts --bundle --platform=node --outfile=dist-cli/cli.js --format=esm --target=node18 --minify",
    "build:gui": "vite build --config vite.gui.config.ts",
    "dev": "bun run build:cli && vite dev --config vite.gui.config.ts",
    "dev:tauri": "bun run build:cli && tauri dev",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:ci": "playwright test --reporter=html"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "axios": "^1.7.0",
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "h264-live-player": "^1.3.1",
    "inquirer": "^9.2.0",
    "lucide-static": "^1.28.0",
    "update-notifier": "^7.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "^2.2.0",
    "@types/cli-progress": "^3.11.0",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^20.0.0",
    "esbuild": "^0.21.0",
    "release-it": "^21.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18"
  }
}
