{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMOS Companion",
  "version": "1.6.43",
  "identifier": "online.amos.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AMOS Companion",
        "width": 900,
        "height": 650,
        "resizable": true,
        "center": true,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "appimage",
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ],
        "section": "Utility",
        "priority": "optional",
        "installHooks": {
          "postInst": [
            {
              "script": "if [ -z \"$(grep '^Categories=' \"${DPKG_MAINTSCRIPT_PACKAGES-}/${DPKG_PACKAGENAME}.desktop}\" 2>/dev/null | cut -d= -f2)\" ]; then sed -i 's/^Categories=$/Categories=Utility;Network;RemoteAccess;DeveloperTools;/' \"${DPKG_MAINTSCRIPT_PACKAGES-}/${DPKG_PACKAGE}.desktop\" 2>/dev/null || sed -i 's/^Categories=$/Categories=Utility;Network;RemoteAccess;DeveloperTools;/' \"${DPKG_MAINTSCRIPT_PACKAGES-}/${DPKG_PACKAGE_NAME}.desktop\" 2>/dev/null || true; fi"
            }
          ]
        }
      }
    },
    "resources": [
      "./scrcpy-server/scrcpy-server.jar",
      "../scripts/*"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
