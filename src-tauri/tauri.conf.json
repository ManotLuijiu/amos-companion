{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMOS Companion",
  "version": "1.6.39",
  "identifier": "online.amos.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AMOS Companion",
        "width": 900,
        "height": 650,
        "resizable": true,
        "center": true,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": {
      "./scrcpy-server/scrcpy-server.jar": "scrcpy-server.jar",
      "../scripts/*": "scripts/"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
