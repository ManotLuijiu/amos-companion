{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMOS Companion",
  "version": "1.6.63",
  "identifier": "online.amos.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "strip": true
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AMOS Companion",
        "width": 900,
        "height": 650,
        "resizable": true,
        "center": true,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "appimage",
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "shortDescription": "Connect Android devices to AMOS with one click",
        "longDescription": "AMOS Companion is a desktop application that allows you to connect your Android devices to the AMOS SaaS platform with a single click. Features include device mirroring, ADB management, and seamless integration with AMOS services.",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libc6"
        ],
        "section": "net",
        "priority": "optional",
        "maintainer": "AMOS Team <support@amos.moo-vpn.online>",
        "homepage": "https://amos.moo-vpn.online",
        "postInstallScript": "../scripts/deb-postinst.sh"
      }
    },
    "resources": [
      "./scrcpy-server/scrcpy-server.jar",
      "../scripts/*",
      "./debian/copyright",
      "./debian/changelog"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
